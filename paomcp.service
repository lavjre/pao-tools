[Unit]
Description=Pao Tools
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pao
WorkingDirectory=/app
Environment=PYTHONPATH=/app
Environment=UV_PROJECT_ENVIRONMENT=/app/.venv
Environment=PAO_RUNTIME_ROOT=/var/lib/pao
Environment=PAO_PYTHON_VENV=/opt/pao-python/shared_venv
# This unit binds 0.0.0.0 for VM networking, which the server's fail-closed
# remote-bind gate only allows with PAO_ALLOW_REMOTE=1 plus a PAO_MCP_TOKEN
# bearer. The Docker image writes /etc/pao/pao.env (mode 0600) at build time
# with a per-build random token so the unit is bootable as shipped; read it
# inside the VM with `cat /etc/pao/pao.env` and replace it for any shared or
# long-lived deployment. On non-image hosts create the file before starting:
#   install -d -m 700 /etc/pao
#   printf 'PAO_MCP_TOKEN=%s\n' "$(head -c 32 /dev/urandom | base64)" \
#     > /etc/pao/pao.env && chmod 600 /etc/pao/pao.env
Environment=PAO_ALLOW_REMOTE=1
EnvironmentFile=/etc/pao/pao.env
ExecStart=/app/.venv/bin/python -m paomcp --host 0.0.0.0 --port 5500
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
